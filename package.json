{
  "name": "fondue",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "relay": "node server/relay/index.mjs",
    "dev-page": "node scripts/dev-page.ts",
    "campaign-table": "node scripts/campaign-table.ts",
    "balance": "node -e \"process.env.BALANCE=1;require('child_process').execSync('npx vitest run',{stdio:'inherit',env:process.env})\"",
    "android:prepare": "npm run build && npx cap add android && node scripts/android-setup.mjs && npx cap sync android"
  },
  "devDependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/cli": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "peerjs": "^1.5.5",
    "phaser": "^4.2.1",
    "ws": "^8.22.2"
  }
}
